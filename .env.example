# Copy with `make init`; the generated .env is mode 600 and ignored by Git.
COMPOSE_PROJECT_NAME=secure-web-starter
MARIADB_IMAGE=mariadb:12.3.2
MAVEN_IMAGE=maven:3.9.11-eclipse-temurin-21
RUNTIME_IMAGE=eclipse-temurin:21-jre-noble

DB_NAME=webapp
DB_USERNAME=webapp
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_BIND_ADDRESS=127.0.0.1
DB_PORT=3306
DB_SLOW_QUERY_SECONDS=1

APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
APP_BOOTSTRAP_ADMIN_ENABLED=true
APP_BOOTSTRAP_ADMIN_USERNAME=admin
APP_BOOTSTRAP_ADMIN_EMAIL=admin@localhost.invalid
APP_BOOTSTRAP_ADMIN_PASSWORD=
APP_REGISTRATION_ENABLED=false
APP_SESSION_METADATA_MAX_ENTRIES=10000
APP_FRAME_OPTIONS=SAMEORIGIN
APP_WORKSPACE_MAX_TABS=12
APP_WORKSPACE_DEFAULT_MENU_KEY=dashboard
APP_WORKSPACE_STORAGE_KEY=secure-mvc-workspace
APP_WORKSPACE_RESERVED_PATHS=/workspace,/login,/logout,/register,/error,/assets,/internal
APP_SQL_LOG_LEVEL=DEBUG
APP_SQL_BIND_LOG_LEVEL=OFF
APP_DB_DRIVER_LOG_LEVEL=OFF
